# Copy to .env and adjust before starting:
#   cp .env.example .env

# Public URL where nginx is reachable (VM IP or hostname)
# Used by Grafana for redirects / share links
PUBLIC_HOST=localhost
PUBLIC_PORT=8085

# Grafana admin (change in test/prod)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# Anonymous access (true for local play; false on shared VM)
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer

# Nginx basic auth for non-Grafana UIs (Prometheus / Loki / Tempo / Alloy)
# Generate: htpasswd -nbB observer 'your-password'
# Leave empty to disable basic auth on those paths (not recommended on a shared VM)
NGINX_BASIC_AUTH_USER=observer
NGINX_BASIC_AUTH_PASSWORD=changeme

# Retention hints (days) — applied via compose env where supported
LOKI_RETENTION_PERIOD=168h
TEMPO_RETENTION_PERIOD=48h
